	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "npm run typecheck:src && npm run typecheck:types && npm run check:type-lane",
		"typecheck:src": "tsc --noEmit",
		"check:type-lane": "node scripts/check-type-lane.mjs",
		"lint": "biome check src/",
		"lint:fix": "biome check --fix src/",
		"lint:all": "biome check src/ tests/",
		"test": "vitest run",
		"test:main": "vitest run",
		"test:main:serial": "vitest run --no-file-parallelism",
		"test:perf": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.perf.config.ts --no-file-parallelism",
		"test:ci": "npm run test:main && npm run test:perf",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"typecheck:types": "tsc -p tsconfig.types.json",
		"api:surface": "node scripts/check-api-surface.mjs --update",
		"check:api-surface": "node scripts/check-api-surface.mjs",
		"check:package": "publint && attw --pack . --profile esm-only",
		"test:coverage": "vitest run --coverage",
		"test:fast": "vitest run tests/core tests/hooks tests/utils tests/plugins tests/cache tests/events",
		"test:contract": "vitest run tests/contract tests/adapters tests/types",
		"test:integration": "vitest run tests/integrations tests/factory tests/auth",
		"test:e2e": "vitest run tests/e2e tests/scenarios tests/smoke",
		"test:changed": "vitest run --changed",
		"test:reliability": "vitest run tests/cache tests/events tests/migrations tests/plugins/schedules.test.ts tests/plugins/health.test.ts tests/utils/circuit-breaker.test.ts tests/utils/compensation-hooks.test.ts tests/integrations/jobs-timeout.test.ts",
		"test:smoke:ws": "vitest run tests/integrations/websocket/smoke.test.ts",
		"test:smoke:redis": "node scripts/smoke-ws-redis.mjs",
		"smoke": "node scripts/smoke-test.mjs",
		"smoke:consumer": "node scripts/smoke-test.mjs --consumer",
		"push": "classytic-push",
		"release:tag": "node -e \"require('child_process').execSync('npm run push -- v'+require('./package.json').version,{stdio:'inherit'})\"",
		"release": "npm run push -- main && npm run release:tag && npm publish",
		"check:peer-skew": "node scripts/check-peer-skew.mjs",
		"check:docs-drift": "node scripts/check-docs-drift.mjs",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"prepublishOnly": "npm run check:peer-skew && npm run check:docs-drift && npm run check:boundaries && npm run typecheck && npm run lint && npm run build && npm run check:api-surface && npm run check:package && npm run test:ci && npm run smoke:consumer"
	},
